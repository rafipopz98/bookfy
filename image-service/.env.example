# All optional — see README.md for details.

# Path to the SD1.5 checkpoint (relative to image-service/, or absolute).
BOOKFY_IMAGE_MODEL=models/anything-v5.safetensors

# Output resolution. Keep this conservative on 8GB unified memory.
BOOKFY_IMAGE_WIDTH=512
BOOKFY_IMAGE_HEIGHT=512

# Inference steps and guidance scale.
BOOKFY_IMAGE_STEPS=20
BOOKFY_IMAGE_GUIDANCE=7.0

# Appended to the built-in default negative prompt, not a replacement for it.
BOOKFY_NEGATIVE_PROMPT_EXTRA=

# Optional LoRAs — a Hugging Face repo id or local path. Leave unset to run
# with the base model only (the default, and the recommended starting point).
BOOKFY_MANGA_LORA=
BOOKFY_LCM_LORA=

# Where generated PNGs are written. Defaults to ../generated (the repo root's
# generated/ directory, shared with the Next.js side).
BOOKFY_GENERATED_DIR=

PORT=8000

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# python image service
image-service/.venv
image-service/__pycache__
image-service/**/__pycache__
image-service/.env
image-service/*.log

# local model weights and caches (downloaded, not committed)
image-service/models
.cache/huggingface

# generated manga panels (local prototype output, not committed)
generated/*
!generated/.gitkeep
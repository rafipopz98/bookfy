# AI scene-analysis / storyboard pipeline (see app/api/visualize/storyboard/route.ts)
#
# Bookfy runs entirely locally through Ollama — no API keys, no external
# inference service. If Ollama isn't running, /visualize transparently falls
# back to a fixed offline demo storyboard so the app stays usable — every
# result is tagged "mock" rather than "ai" in the UI when that happens.
#
# 1. Install Ollama: https://ollama.com  (or `brew install ollama`)
# 2. Start it:        brew services start ollama  (or `ollama serve`)
# 3. Pull the model:  ollama pull qwen2.5:3b-instruct

# Ollama's local OpenAI-compatible endpoint. Defaults to this value if unset.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Which local model to use. Defaults to qwen2.5:3b-instruct if unset.
BOOKFY_AI_MODEL=qwen2.5:3b-instruct

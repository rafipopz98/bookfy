# AI scene-analysis / storyboard pipeline (see app/api/visualize/storyboard/route.ts)
#
# Bookfy calls an LLM through the Vercel AI Gateway. Without a key, /visualize
# transparently falls back to a fixed offline demo storyboard — the app stays
# usable, but every result is tagged "mock" rather than "ai" in the UI.
#
# Get a key: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys
AI_GATEWAY_API_KEY=

# Optional: override the default model (a Vercel AI Gateway "provider/model" string).
# Defaults to anthropic/claude-sonnet-5 if unset.
BOOKFY_AI_MODEL=
